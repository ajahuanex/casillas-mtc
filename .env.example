# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA DE CASILLAS ELECTRÓNICAS
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="Sistema de Notificaciones - Casilla Electrónica MTC / GORE PUNO"
API_V1_STR=/api/v1
SECRET_KEY=cambiar_esta_clave_secreta_super_segura_para_jwt_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# BASE DE DATOS POSTGRESQL (Transaccional + JSONB MTC)
# ==============================================================================
POSTGRES_USER=casillas_user
POSTGRES_PASSWORD=casillas_secret_pass
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casillas_db
DATABASE_URL=postgresql+asyncpg://casillas_user:casillas_secret_pass@localhost:5432/casillas_db

# ==============================================================================
# ALMACENAMIENTO DE OBJETOS RUSTFS / S3 (PDFs, Firmas y Acuses)
# ==============================================================================
STORAGE_TYPE=rustfs
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
RUSTFS_BUCKET_NAME=casillas-notificaciones
RUSTFS_ENDPOINT=localhost:9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_SECURE=false
RUSTFS_PUBLIC_URL_BASE=http://localhost:9000

# Retrocompatibilidad
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=rustfsadmin
MINIO_ROOT_PASSWORD=rustfsadmin123
MINIO_BUCKET_NAME=casillas-notificaciones
MINIO_SECURE=false
MINIO_PUBLIC_URL_BASE=http://localhost:9000

# ==============================================================================
# REDIS (Caché de Tokens y Worker de Sincronización de Acuses)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# CREDENCIALES OFICIALES MTC - SERVICIOS PÚBLICOS MTC
# ==============================================================================
MTC_BASE_URL=https://wscasilla.mtc.gob.pe/ms-notific/v2/servicios-publicos
MTC_CLIENT_ID=e8c61edc-f33b-4b64-b241-a2bc85c73402
MTC_CLIENT_SECRET=wqetekyaQHPK3QwAksSKuNofH0Cp5kIzBwht8lC3VC6XdRTjTZysTEwJEfAGCyWi0FSGDUPXEAMl6dTBli9tBqrStLTmh8fj3b7whBaSUnHGvE6LYTIUuMgjjphqeiqJ
MTC_GRANT_TYPE=authorization_code

# Intervalo en segundos para el sondeo de constancias de lectura en segundo plano
MTC_POLLING_INTERVAL_SECONDS=180

# ==============================================================================
# API CASILLAS ELECTRÓNICAS OFICIAL DRTC PUNO (NODE-RED)
# ==============================================================================
# Desarrollo: https://casillas.transportespuno.gob.pe/api/v2
# Producción: https://mtc.transportespuno.gob.pe/api/v2
MTC_DRTC_BASE_URL=https://casillas.transportespuno.gob.pe/api/v2
MTC_DRTC_API_KEY=topSecret123
